# ============================================================================
# NutriAI - Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git (ya está en .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service role key: SOLO en el servidor. NUNCA con prefijo NEXT_PUBLIC_.
# Se usa en el panel de administración para operaciones privilegiadas.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# ----------------------------------------------------------------------------
# OpenAI (https://platform.openai.com/api-keys)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-pega-aqui-tu-clave
# Modelo de chat para el Coach y rutinas
OPENAI_MODEL=gpt-4o-mini
# Modelo con visión para el análisis de fotos de comida
OPENAI_VISION_MODEL=gpt-4o

# ----------------------------------------------------------------------------
# ExerciseDB (RapidAPI) — GIFs reales de ejercicios para las rutinas
# Crea una API key gratis en:
# https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# ----------------------------------------------------------------------------
RAPIDAPI_KEY=

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NutriAI

# Email(s) administrador, separados por coma. Acceso al panel /admin.
ADMIN_EMAILS=tu-email@ejemplo.com

# ----------------------------------------------------------------------------
# Suscripción / apoyo (Bre-B · Nequi/Bancolombia) — pago manual
# ----------------------------------------------------------------------------
# Llave Bre-B (ej. @tuusuario) o número, y precios de cada plan.
NEXT_PUBLIC_PAYMENT_KEY=
NEXT_PUBLIC_PRICE_GENERAL=
NEXT_PUBLIC_PRICE_AI=
# Límite mensual de usos de IA por usuario (control de costos). Por defecto 200.
AI_MONTHLY_LIMIT=200
# WhatsApp en formato internacional (ej. 57XXXXXXXXXX) para recibir comprobantes.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Secreto para proteger el cron de limpieza (texto largo aleatorio).
CRON_SECRET=
